# Python
.venv/
.venv-*/
.DS_Store
__pycache__/
*.pyc
.pytest_cache/

# Node helper tooling (tools/alphatab) — deps are re-installable
node_modules/

# Secrets — NEVER commit (LLM provider keys etc.)
.env
.env.*
*.env
*.env.local
!.env.example

# Generated artifacts (tabs/previews written by a run). Run outputs are
# archived under runs/<date>/ so the repo root stays source-only.
out.*
runs/
dump_*/

# Web runtime output
web/results/

# WorkBuddy internal (agent memory/state) — not product source
.workbuddy/

# Local test fixtures — real tabs are copyrighted, never commit them to the
# public repo. This directory is the multi-source eval set; it lives only on
# machines that have the files.
fixtures/
